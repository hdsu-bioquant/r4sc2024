nCount_RNA < 4000 &
percent.mt < 5)
ncol(ad_medula_filtered)
ad_medula_filtered <- NormalizeData(ad_medula_filtered)
ad_medula_filtered <- ScaleData(ad_medula_filtered)
ad_medula_filtered <- FindVariableFeatures(ad_medula_filtered, nfeatures = 1000)
head(VariableFeatures(ad_medula_filtered))
# plot variable features with and without labels
plot1 <- VariableFeaturePlot(ad_medula_filtered)
plot1 <- LabelPoints(plot = plot1,
points = head(VariableFeatures(ad_medula_filtered),
10),
repel = TRUE)
plot1
ad_medula_filtered <- RunPCA(ad_medula_filtered,
features = VariableFeatures(ad_medula_filtered))
ElbowPlot(ad_medula_filtered)
ad_medula_filtered <- RunPCA(ad_medula_filtered,
features = VariableFeatures(ad_medula_filtered))
ElbowPlot(ad_medula_filtered)
ad_medula_filtered <- FindNeighbors(ad_medula_filtered)
ad_medula_filtered <- FindClusters(ad_medula_filtered,
resolution = 0.1,
verbose = FALSE)
head(ad_medula_filtered$seurat_clusters)
table(ad_medula_filtered$seurat_clusters)
ad_medula_filtered <- RunUMAP(ad_medula_filtered,
dims = 1:7,
verbose = FALSE)
Idents(ad_medula_filtered) <- ad_medula_filtered$seurat_clusters
ad_medula.degs <- FindAllMarkers(ad_medula_filtered,
logfc.threshold = 1,
min.pct = 0.05,
min.cells.feature = 10,
verbose = FALSE)
head(ad_medula.degs)
library(ggplot2)
library(dplyr)         ## for handling data frames
library(ggrepel)
ad_medula.degs %>%
filter(cluster=='0') %>%
filter(p_val_adj > 0) %>%
arrange(desc(abs(avg_log2FC))) %>%       ## Arranging genes by FC
mutate(highlight=ifelse(-log10(p_val_adj)>125, TRUE, FALSE)) %>% ## highlighting top FC markers
mutate(gene_label=ifelse(highlight==TRUE, gene, '')) %>% ## Adding labels for top markers
ggplot(aes(x=avg_log2FC, y=-log10(p_val_adj),
colour=highlight,
label=gene_label)) +         ## adding labels for top markers
geom_point() +
geom_text_repel() +
theme_bw()
top10 <- ad_medula.degs %>%
group_by(cluster) %>%
top_n(n = 10, wt = avg_log2FC)
DoHeatmap(ad_medula_filtered,
features = top10$gene) + NoLegend()
canonical_markers <- c(
"PLP1",
"MPZ",
"SOX10",
"CDX19",
"ERBB3",
"ERBB4",
"CDH9",
"CTTNBP2",
"ASCL1",
"DBH",
"TH",
"CHGA",
"DDC",
"PNMT",
"TOP2A",
"NEFM",
"GAP43",
"SMTN2",
"ISL1",
"ALK",
"SYN3",
"IL7"
)
DotPlot(ad_medula_filtered,
features = canonical_markers) +
coord_flip()
FeaturePlot(ad_medula_filtered,
features = c("CHGA",
"IL7",
"CDH9",
"MPZ"),
order = TRUE)
mapping <- data.frame(seurat_cluster=c('0',
'1',
'2',
'3'),
cell_type=c('Chromaffin cells',
'Late neuroblasts',
'Bridge',
'SCP'))
mapping
ad_medula_filtered$'cell_type' <- plyr::mapvalues(
x = ad_medula_filtered$seurat_clusters,
from = mapping$seurat_cluster,
to = mapping$cell_type
)
DimPlot(ad_medula_filtered,
group.by = 'cell_type',   ## set the column to use as category
label = TRUE, reduction = 'umap')  +          ## label clusters
NoLegend()                ## remove legends
invisible({
library(openxlsx)
library(HGNChelper)
})
source("https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/R/sctype_wrapper.R")
ad_medula_filtered <- FindClusters(ad_medula_filtered,
resolution = 1,
verbose = FALSE)
sample <- run_sctype(ad_medula_filtered,
assay = "RNA",
scaled = TRUE,
known_tissue_type="Adrenal",
custom_marker_file="https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/ScTypeDB_full.xlsx",
name="sctype_classification")
head(sample@meta.data)
DimPlot(sample,
group.by = 'sctype_classification',
label = TRUE) + NoLegend()
